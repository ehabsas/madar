{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "madar",
  "version": "0.1.2",
  "identifier": "com.madar.business",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Madar | Business Management System",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
